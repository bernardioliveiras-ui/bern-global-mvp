{
  "name": "bern-nexus",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "db:create": "wrangler d1 create bern-nexus-db",
    "db:migrate:local": "wrangler d1 migrations apply bern-nexus-db --local",
    "db:migrate": "wrangler d1 migrations apply bern-nexus-db --remote",
    "deploy": "wrangler d1 migrations apply bern-nexus-db --remote && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  }
}
