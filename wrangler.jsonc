{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bern-nexus",
  "main": "./src.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bern-nexus-db",
      "database_id": "COLE_AQUI_O_DATABASE_ID_DO_D1",
      "migrations_dir": "migrations"
    }
  ]
}
